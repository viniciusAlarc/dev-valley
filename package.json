{
  "name": "dev-valley",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run dev -w server\" \"npm run dev -w web\"",
    "build": "npm run build -w web",
    "start": "npm run build && npm run start -w server",
    "test": "tsx --test \"server/tests/*.test.ts\" \"web/tests/*.test.ts\"",
    "hooks:install": "npm run hooks:install -w server",
    "hooks:uninstall": "npm run hooks:uninstall -w server"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true
  }
}
